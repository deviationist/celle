# celle configuration. Copy to .env (dev) or .env.prod (production).

# API tokens, comma-separated, at least 16 characters each. They never expire;
# remove one to revoke it. One per sheet or person makes revoking easy.
# Generate: openssl rand -hex 24
CELLE_TOKENS=

# Time zone that decides what "today" is, unless a request passes ?tz=.
CELLE_DEFAULT_TZ=Europe/Oslo

# Host publish (compose only). Bind to loopback or a private interface and put
# a TLS reverse proxy in front.
CELLE_BIND=127.0.0.1
CELLE_PORT=8095

# Listen address inside the process (go run / the binary). Compose sets :8080.
# CELLE_ADDR=:8080
